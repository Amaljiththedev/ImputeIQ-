# Template only. Copy to .env and fill in real values there.
# .env is gitignored; this file is committed, so it must never hold a real
# secret. Keys pasted here are published the moment the repo is pushed.

# Groq API key -- create one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Overrides the default model without a code change, which matters
# because Groq retires model ids periodically. Leave blank to use the default.
GROQ_MODEL=
